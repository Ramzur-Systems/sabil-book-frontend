# Base URL of the Sabil Qalam REST API.
VITE_API_BASE_URL=/api/v1
# When "true", MSW intercepts API calls in dev with seeded fixtures.
# Set to "false" once the Django marketplace endpoints are live.
VITE_USE_MOCKS=true
# Dev-server proxy target for /api/* when mocks are off.
VITE_DJANGO_PROXY_TARGET=http://127.0.0.1:8000
