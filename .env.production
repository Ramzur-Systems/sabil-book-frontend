# Deployed demo build.
#
# The marketplace endpoints do not exist server-side yet, so the deployed app
# runs against the MSW mock API in the browser. Data is seeded per page load
# and resets on refresh — this is a demo, not a staging environment.
#
# To point the deployment at a real backend, set both of these in the Vercel
# project's Environment Variables (they override this file):
#   VITE_USE_MOCKS=false
#   VITE_API_BASE_URL=https://<your-api-host>/api
VITE_API_BASE_URL=/api
VITE_USE_MOCKS=true
